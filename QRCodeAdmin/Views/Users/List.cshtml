@model  Models.AllVM
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<form id="form1">
    <div style="float:left"><h2>使用者維護</h2></div>
    @if (Session["Role"].ToString() == "1" || Session["Role"].ToString() == "2")
    {
    <div style="float:left; margin: 20px 0 0 40px"><a class="btn btn-default" href="../Users/Edit">新增</a></div>
    }
    <table class="table"> 
    <tr>
    <th>序號</th>
    <th>角色</th>
    <th>姓名</th>
    <th>工號</th>
    <th>單位</th>
    <th>Email</th>
    <th>啟用/停用</th>
    <th>操作</th>
    </tr>
    @{ 
        int i = 1;
        foreach (var info in Model.UsersProList)
        {
        <tr>
        <td>@(i++)</td>
        <td>@info.Roles</td>
        <td>@info.Name</td>
        <td>@info.GID</td>
        <td>@info.UnitCode</td>
        <td>@(info.Email)</td>
        <td>@(info.Enabled == 1 ? "啟用" : "停用")</td>
        <td>
        @if (Session["Role"].ToString() == "1" || Session["Role"].ToString() == "2")
        {
        <a class="btn btn-default" href="javascript:;" onclick="edit('@info.SNO')">編輯</a>
        <a class="btn btn-default" href="javascript:;" onclick="if (confirm('確定刪除')) { del('@info.SNO'); }">刪除</a>
        }
        </td>
        </tr>
        }
    }
    </table>
    <input type="hidden" id="SNO" name="SNO" value="" />
</form>

@section scripts {

<script>

    function edit(SNO)
    {
        location.href = "../Users/Edit?SNO=" + SNO;
    }

    function del(SNO)
    {
        $("#SNO").val(SNO);
        var formData = new FormData($('#form1')[0]);
        $.ajax({
            type: "post",
            url: "../Users/Del",
            data: formData,
            dataType: false,
            contentType: false,
            processData: false,
            async: true,
            success: function (response) {
                alert(response.msg);
                location.href = response.url;
            },
            complete: function () {

            },
            error: function () {
                alert("error");
            }
        });
    }
</script>
}
