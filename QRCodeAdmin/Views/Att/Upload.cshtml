    <a class="btn btn-default" href="../Hou/List?PrjSNO=@ViewBag.qy_PrjSNO">返回</a>
    <input type="submit" value="儲存" class="btn btn-default" />
</form>

@section scripts {
<script>

    function check_form() {
        document.forms[0].submit();
        //save();
    }

    function save() {
        

        var formData = new FormData($('#form1')[0]);
        $.ajax({
            type: "post",
            url: "../Att/Upload",
            data: formData,
            contentType: false, //for 檔案上傳
            cache: false,       //for 檔案上傳
            processData: false, //for 檔案上傳
            async: true,
            success: function (response) {
                alert(response.msg);
                //location.reload();
            },
            complete: function () {

            },
            error: function () {
                alert("error");
            }
        });
    }

</script>
}