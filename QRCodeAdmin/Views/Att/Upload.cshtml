    @{ 
        var cnt = Model.AttProList.Where(x => x.AttSort == 1).Count();
        var info = new Models.AttPro();
        var AttTitle = "";

        if (cnt > 0)
        {
            info = Model.AttProList.Where(x => x.AttSort == 1).FirstOrDefault();
        }
        else
        {
            info = new Models.AttPro();
        }
        AttTitle = Model.AttTitles.Where(x => x.Code == "a").FirstOrDefault().Text;
    }
    <tr>
    <td>1<input type="hidden" id="AttSNO01" name="AttSNO01" value="@info.AttSNO" /></td>
    <td>@AttTitle<input type="hidden" id="AttTitle01" name="AttTitle01" value="@AttTitle" /></td>
    <td>
        <div><a href="../upload/@Model.PrjInfo.PrjCode/@info.AttFileName" target="_blank">@info.AttFileName</a></div>
        <div>此為共用文件，欲編輯請至戶號管理，按下交屋手冊上傳鈕</div>
    </td>
    <td>@info.AttNote</td>
    </tr>
